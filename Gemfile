source "https://rubygems.org"

# Matches the environment GitHub Pages builds this site in, so a local build
# reproduces production rather than approximating it.
gem "github-pages", group: :jekyll_plugins

# Windows does not ship the zoneinfo database Ruby expects.
gem "tzinfo-data", platforms: [:mingw, :mswin, :x64_mingw, :jruby]
gem "wdm", "~> 0.1", platforms: [:mingw, :mswin, :x64_mingw]
