# Auto detect text files and perform LF normalization
* text=auto
*.mp4 filter=lfs diff=lfs merge=lfs -text
*.bz2 filter=lfs diff=lfs merge=lfs -text

# Shell scripts must keep LF in the working tree. core.autocrlf is true on the
# machine this repo is maintained from, and a CRLF shebang makes bash fail with
# "bad interpreter: /usr/bin/env bash^M".
*.sh text eol=lf
